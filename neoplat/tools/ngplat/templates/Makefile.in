# Makefile generado por ngplat para "@TITLE@".
# Se reescribe en cada `ngplat build`: pon tus cambios en game.yaml.
#
# Necesita ngdevkit (https://github.com/dciabrin/ngdevkit) en el PATH:
#   m68k-neogeo-elf-gcc, m68k-neogeo-elf-objcopy y, para probar, ngdevkit-gngeo.

ROMID    := @ROMID@
CC       := m68k-neogeo-elf-gcc
OBJCOPY  := m68k-neogeo-elf-objcopy
GNGEO    ?= ngdevkit-gngeo

# -fno-store-merging: sin el, gcc junta dos escrituras de un byte seguidas en
# una sola de dos bytes, y si cae en una direccion impar el 68000 se para con
# un "address error". Las pruebas del kit comprueban que no quede ninguna.
CFLAGS   := -std=c99 -Os -fomit-frame-pointer -fno-store-merging \
            -Wall -Wextra -Isrc
LDFLAGS  :=

SRC      := src/main.c src/np_video.c src/np_hud.c src/np_sound.c src/np_world.c \
            src/gamedata.c
OBJ      := $(SRC:.c=.o)

PROM     := rom/$(ROMID)-p1.p1
CROM1    := rom/$(ROMID)-c1.c1
CROM2    := rom/$(ROMID)-c2.c2
SROM     := rom/$(ROMID)-s1.s1
MROM     := rom/$(ROMID)-m1.m1
VROM     := rom/$(ROMID)-v1.v1

all: $(PROM) $(VROM)
	@echo "ROM lista en rom/ (ROM id $(ROMID))"

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

game.elf: $(OBJ)
	$(CC) $(CFLAGS) -o $@ $(OBJ) $(LDFLAGS)

$(PROM): game.elf
	@mkdir -p rom
	$(OBJCOPY) -O binary $< $@

# La ROM M1 (driver de sonido del Z80, con tu musica y tus efectos) la genera
# 'ngplat compilar'. La V1 son muestras digitales: aun no se usan.
$(VROM):
	@mkdir -p rom
	dd if=/dev/zero of=$@ bs=1024 count=128 2>/dev/null

# `make run` arranca el emulador de ngdevkit con la ROM recien construida.
run: all
	$(GNGEO) -i rom --autoframeskip=0 puzzledp

clean:
	rm -f $(OBJ) game.elf $(PROM)

.PHONY: all run clean
